cc_binary(
    name = "enrich_events",
    srcs = ["src/enrich_events_main.cpp"],
    linkstatic = True,
    deps = [
        ":event_enricher",
        ":event_recovery",
        ":pg_util",
        ":util",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/flags:parse",
        "@com_google_absl//absl/log:initialize",
        "@com_google_absl//absl/log:log",
        "@com_google_absl//absl/strings:strings",
        # _PQ on the arm64 sysroot only re-exports its own -l flags; libpq.a
        # references LDAP/SASL/GnuTLS symbols that only get pulled in when
        # libcurl is also linked.  Include _CURL so we inherit that full
        # transitive set without having to enumerate it here.
    ] + _PQ + _CURL,
)
