#!/bin/sh
# Pre-remove script for onvif-recorder.
# On removal, stops the service, rolls back cameras-table changes, reverts UI
# and nginx patches before the binary is deleted from disk.  On upgrade the
# service keeps running.
set -e

case "$1" in
    upgrade)
        # The running recorder keeps serving while dpkg unpacks the new
        # files, and postinst restarts it with the new binary.  Stopping it
        # here would leave Protect without events for the whole unpack on
        # cameras whose events are shared through the recorder.
        # Timers keep their enabled state across upgrades (issue #55).
        ;;
    remove|deconfigure)
        systemctl stop onvif-recorder.service 2>/dev/null || true
        systemctl disable --now onvif-recorder-channel.timer 2>/dev/null || true
        systemctl disable --now onvif-recorder-autoupdate.timer 2>/dev/null \
            || true

        # On removal, roll back DB changes + revert patches.
        if [ "$1" = "remove" ]; then
            if [ -x /usr/bin/onvif-recorder ]; then
                /usr/bin/onvif-recorder --rollback=all 2>&1 | \
                    systemd-cat -t onvif-recorder-rollback || true
            fi
        fi
        ;;
    failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
