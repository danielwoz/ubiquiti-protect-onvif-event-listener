#!/bin/sh
# Post-remove script for onvif-recorder.
# `remove` cleans up runtime-created files; `purge` also removes configuration
# and state directories.
set -e

case "$1" in
    remove)
        # Compat symlink — may have been created by postinst.
        rm -f /usr/bin/onvif_recorder
        # The keyring is dpkg-owned now, so dpkg deletes it on remove.  The
        # source list lives in /etc and was only cleaned up on purge, which
        # would leave a `signed-by=` pointing at a file that no longer
        # exists — breaking `apt-get update` system-wide for anyone who
        # merely removed the package.  Drop it here too.
        rm -f /etc/apt/sources.list.d/onvif-recorder.list
        systemctl daemon-reload 2>/dev/null || true
        ;;
    purge)
        rm -f /usr/bin/onvif_recorder
        rm -rf /etc/onvif-recorder
        rm -rf /var/lib/onvif-recorder
        rm -rf /etc/systemd/system/onvif-recorder-autoupdate.timer.d
        rm -f /etc/apt/sources.list.d/onvif-recorder.list
        rm -f /usr/share/keyrings/onvif-recorder-archive-keyring.gpg
        # The recovery layer re-installs the package on boot whenever the
        # binary is missing, which is the state a purge leaves.  A purge is
        # a deliberate removal, so drop its boot and backup jobs.  Its
        # scripts and config backups stay in /data for a later reinstall;
        # see the README's Uninstall section to remove those too.
        rm -f /etc/cron.d/onvif-recorder-boot-restore
        rm -f /etc/cron.d/onvif-recorder-backup
        systemctl daemon-reload 2>/dev/null || true
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
