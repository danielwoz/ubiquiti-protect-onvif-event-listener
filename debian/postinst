#!/bin/sh
# Post-install script for onvif-recorder.
# Migrates from the pre-package /root/* layout, installs the APT source for
# the detected Protect channel, and enables the systemd units.
set -e

LEGACY_BIN=/root/onvif_recorder
LEGACY_BIN_BAK=/root/onvif_recorder.bak
LEGACY_BIN_NEW=/root/onvif_recorder.new
LEGACY_LOG=/var/log/onvif-recorder.log
LEGACY_API_KEY=/root/.config/onvif-recorder-api-key
LEGACY_MODELS_DIR=/root/models
LEGACY_UNIT=/etc/systemd/system/onvif-recorder.service

STATE_DIR=/var/lib/onvif-recorder
MODELS_DIR=/usr/share/onvif-recorder/models

case "$1" in
    configure)
        # ----- Migrate API-key cache -----
        if [ -f "$LEGACY_API_KEY" ]; then
            mkdir -p "$STATE_DIR"
            if [ ! -f "$STATE_DIR/protect-user-id" ]; then
                cp "$LEGACY_API_KEY" "$STATE_DIR/protect-user-id"
                chmod 600 "$STATE_DIR/protect-user-id"
            fi
            rm -f "$LEGACY_API_KEY"
            rmdir /root/.config 2>/dev/null || true
        fi

        # ----- Migrate model files if package didn't ship them -----
        if [ -d "$LEGACY_MODELS_DIR" ]; then
            if [ ! -f "$MODELS_DIR/nanodet_m.bin" ] && \
               [ -f "$LEGACY_MODELS_DIR/nanodet_m.bin" ]; then
                mkdir -p "$MODELS_DIR"
                cp "$LEGACY_MODELS_DIR/nanodet_m.param" "$MODELS_DIR/" \
                    2>/dev/null || true
                cp "$LEGACY_MODELS_DIR/nanodet_m.bin"   "$MODELS_DIR/" \
                    2>/dev/null || true
            fi
            rm -rf "$LEGACY_MODELS_DIR"
        fi

        # ----- Remove legacy files (package owns these paths now) -----
        # Only remove the unit if it's a plain file (not a symlink into our
        # package's unit), and only if it still contains the old ExecStart.
        if [ -f "$LEGACY_UNIT" ] && [ ! -L "$LEGACY_UNIT" ]; then
            if grep -q '^ExecStart=/root/onvif_recorder' "$LEGACY_UNIT" \
                2>/dev/null; then
                rm -f "$LEGACY_UNIT"
            fi
        fi
        rm -f "$LEGACY_BIN" "$LEGACY_BIN_BAK" "$LEGACY_BIN_NEW"
        rm -f "$LEGACY_LOG" "$LEGACY_LOG".* 2>/dev/null || true

        # ----- Legacy compat symlink so old scripts that call onvif_recorder -----
        # (underscore) keep working.
        if [ ! -e /usr/bin/onvif_recorder ]; then
            ln -sf onvif-recorder /usr/bin/onvif_recorder
        fi

        # ----- Create state dir -----
        mkdir -p "$STATE_DIR"
        chmod 700 "$STATE_DIR"

        # ----- Ensure config dir + default channel exist -----
        mkdir -p /etc/onvif-recorder
        if [ ! -f /etc/onvif-recorder/channel ]; then
            echo "stable" > /etc/onvif-recorder/channel
        fi

        # ----- Detect channel from Protect (best effort) + write APT source --
        /usr/libexec/onvif-recorder/detect-channel.sh || true
        /usr/libexec/onvif-recorder/install-apt-source.sh || true

        # ----- Reload systemd + enable units -----
        # $2 is the previous version on upgrade, empty on a fresh install.
        # A fresh install enables every unit.  An upgrade keeps the timers'
        # enabled state, except for the one-time repair below.
        systemctl daemon-reload
        if [ -z "$2" ]; then
            # Fresh install
            systemctl enable --now onvif-recorder.service \
                                    onvif-recorder-channel.timer \
                                    onvif-recorder-autoupdate.timer
        else
            # Upgrade: the service is always on; timer state is kept.
            systemctl enable --now onvif-recorder.service
            # Pick up the new binary if the service was already
            # running, no-op if it was stopped.
            systemctl try-restart onvif-recorder.service || true
            # prerm before 1.6.28 disabled both timers on every upgrade
            # (issue #55).  Re-enable the channel timer, and the autoupdate
            # timer if the old prerm stopped it during this upgrade, or if
            # the admin Auto-update card (which writes schedule.conf) was
            # never used and config.json does not turn auto-update off.
            if dpkg --compare-versions "$2" lt 1.6.28~; then
                systemctl enable --now onvif-recorder-channel.timer || true
                dropin=/etc/systemd/system/onvif-recorder-autoupdate.timer.d/schedule.conf
                if journalctl -q -b --since=-10min -o cat \
                       -u onvif-recorder-autoupdate.timer 2>/dev/null \
                       | grep -q '^Stopped' || \
                   { [ ! -e "$dropin" ] && \
                     ! grep -Eqs '"autoupdate_enabled"[[:space:]]*:[[:space:]]*"?false' \
                         /etc/onvif-recorder/config.json; }; then
                    systemctl enable --now onvif-recorder-autoupdate.timer \
                        || true
                else
                    echo "onvif-recorder: auto-update is off; turn it on under" \
                         "Auto-update on the admin page if wanted." >&2
                fi
            fi
            # Re-arm running timers so a changed schedule takes effect.
            systemctl try-restart onvif-recorder-channel.timer \
                                  onvif-recorder-autoupdate.timer || true
        fi

        # Deploy/refresh the persistent recovery layer on /data so the
        # package can reinstall itself after a firmware upgrade wipes
        # /usr.  Until now only the curl bootstrap did this, so apt-only
        # installs had no recovery and lost the package on every UniFi OS
        # update (issue #51).  Best-effort: a failure here must never
        # fail the install.
        if [ -x /usr/share/onvif-recorder/recovery-layer.sh ]; then
            /usr/share/onvif-recorder/recovery-layer.sh || \
                echo "warning: recovery layer deployment failed (non-fatal)" >&2
        fi
        ;;
    triggered)
        # Activated whenever another package modifies one of the paths
        # listed in debian/triggers (currently /usr/share/unifi-protect/app).
        # The recorder re-applies all swai.js / nginx patches on startup,
        # so a try-restart is the whole intervention -- it picks up the
        # new file hashes and re-injects the picker patch + nginx blocks.
        # `try-restart` (rather than `restart`) leaves the service alone
        # if the user has explicitly stopped it.
        systemctl try-restart onvif-recorder.service || true
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
