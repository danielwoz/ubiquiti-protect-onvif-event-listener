<Page x:Class="OnvifRecorderInstaller.Pages.ChannelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Channel">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   Style="{StaticResource H1}"
                   Text="Step 3 — Choose a release channel"/>

        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource Body}">
                Each channel gets onvif-recorder releases at a different
                stage of testing. If you pick the channel that matches UniFi
                Protect's release channel, onvif-recorder moves with Protect
                whenever Protect's channel changes. Any other choice stays
                put until you change it on the admin page.
            </TextBlock>

            <TextBlock x:Name="DetectedText" Style="{StaticResource Body}"
                       Foreground="#555" Text="Detecting…"/>

            <TextBlock x:Name="PinnedText" Style="{StaticResource Body}"
                       Foreground="#555" Visibility="Collapsed"/>

            <ComboBox x:Name="ChannelCombo" Margin="0,8,0,0" MinWidth="360"
                      HorizontalAlignment="Left" IsEnabled="False"
                      SelectionChanged="ChannelCombo_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="IsEnabled"
                                Value="{Binding Selectable, Mode=OneWay}"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock><Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding VersionText, Mode=OneWay}" Foreground="#555"/></TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock x:Name="ChannelDescriptionText" Style="{StaticResource Body}"
                       Foreground="#555" Margin="0,6,0,8"/>

            <TextBlock x:Name="CatalogSourceText" Style="{StaticResource Body}"
                       Foreground="#555" Visibility="Collapsed"/>

            <TextBlock x:Name="UpdateText" Style="{StaticResource Body}"
                       Foreground="#92400E" Visibility="Collapsed"/>

            <TextBlock x:Name="PinHintText" Style="{StaticResource Body}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Back" Click="Back_Click"/>
            <Button Content="Install" x:Name="InstallButton"
                    IsDefault="True" IsEnabled="False"
                    Click="Install_Click"/>
        </StackPanel>
    </Grid>
</Page>
