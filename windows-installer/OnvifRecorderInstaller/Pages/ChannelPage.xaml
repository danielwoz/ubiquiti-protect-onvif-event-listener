<Page x:Class="OnvifRecorderInstaller.Pages.ChannelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Channel">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   Style="{StaticResource H1}"
                   Text="Step 3 — Choose a release channel"/>

        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource Body}">
                onvif-recorder ships in three channels that mirror UniFi
                Protect's own release channels. The installer reads Protect's
                channel and selects the matching one; onvif-recorder then
                moves with Protect whenever you change Protect's channel.
                Pick a different channel to keep onvif-recorder on it
                regardless of Protect.
            </TextBlock>

            <TextBlock x:Name="DetectedText" Style="{StaticResource Body}"
                       Foreground="#555" Text="Detecting…"/>

            <TextBlock x:Name="PinnedText" Style="{StaticResource Body}"
                       Foreground="#555" Visibility="Collapsed"/>

            <StackPanel x:Name="ChoicesPanel" Margin="0,8,0,0"
                        IsEnabled="False">
                <RadioButton x:Name="StableRadio"
                             GroupName="Channel" Margin="0,4"
                             Checked="Channel_Checked">
                    <StackPanel>
                        <TextBlock Text="Stable" FontWeight="SemiBold"/>
                        <TextBlock Text="Production releases. Recommended for most users."
                                   Foreground="#555"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RcRadio"
                             GroupName="Channel" Margin="0,4"
                             Checked="Channel_Checked">
                    <StackPanel>
                        <TextBlock Text="Release Candidate" FontWeight="SemiBold"/>
                        <TextBlock Text="Upcoming releases promoted from early-access."
                                   Foreground="#555"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="EaRadio"
                             GroupName="Channel" Margin="0,4"
                             Checked="Channel_Checked">
                    <StackPanel>
                        <TextBlock Text="Early Access" FontWeight="SemiBold"/>
                        <TextBlock Text="Bleeding-edge builds on every tag. Match UniFi Protect's Early Access channel."
                                   Foreground="#555"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <TextBlock x:Name="PinHintText" Style="{StaticResource Body}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Back" Click="Back_Click"/>
            <Button Content="Install" x:Name="InstallButton"
                    IsDefault="True" IsEnabled="False"
                    Click="Install_Click"/>
        </StackPanel>
    </Grid>
</Page>
